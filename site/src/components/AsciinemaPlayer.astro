---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  src: string;
  autoPlay?: boolean;
  loop?: boolean;
  speed?: number;
  theme?: string;
  rows?: number;
  cols?: number;
}

const {
  src,
  autoPlay = false,
  loop = false,
  speed = 1.0,
  theme = 'asciinema',
  rows,
  cols,
  ...rest
} = Astro.props;

// Generate a unique ID for this player instance
const playerId = `player-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="asciinema-player-wrapper">
  <div id={playerId}></div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/asciinema-player@3/dist/bundle/asciinema-player.css" />
<script src="https://cdn.jsdelivr.net/npm/asciinema-player@3/dist/bundle/asciinema-player.min.js" defer is:inline></script>

<script define:vars={{ playerId, src, autoPlay, loop, speed, theme, rows, cols }} is:inline>
  // Wait for AsciinemaPlayer to be available
  function initPlayer() {
    const playerDiv = document.getElementById(playerId);
    if (!playerDiv) return;

    if (window.AsciinemaPlayer) {
      const options = {
        autoPlay,
        loop,
        speed,
        theme,
        fit: 'width',
      };

      if (rows) options.rows = parseInt(rows);
      if (cols) options.cols = parseInt(cols);

      window.AsciinemaPlayer.create(src, playerDiv, options);
    } else {
      // Retry if player library not loaded yet
      setTimeout(initPlayer, 50);
    }
  }

  // Wait for DOM to be fully loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPlayer);
  } else {
    initPlayer();
  }
</script>

<style>
  .asciinema-player-wrapper {
    margin: 1.5rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
  }
</style>

