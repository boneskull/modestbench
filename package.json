{
  "name": "modestbench",
  "version": "0.1.0",
  "type": "module",
  "description": "A framework which wraps around tinybench to provide structure, consistency and convenience to developers creating and maintaining benchmarks",
  "repository": {
    "type": "git",
    "url": "https://github.com/boneskull/modestbench.git"
  },
  "homepage": "https://github.com/boneskull/modestbench#readme",
  "bugs": {
    "url": "https://github.com/boneskull/modestbench/issues"
  },
  "author": "Christopher Hiller <boneskull@boneskull.com>",
  "license": "BlueOak-1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "modestbench": "dist/cli/index.js"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.cts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "benchmark",
    "tinybench",
    "performance",
    "cli",
    "testing"
  ],
  "scripts": {
    "build": "zshy",
    "clean": "rm -rf dist",
    "commitlint": "commitlint",
    "dev": "zshy --watch",
    "fix": "run-s -sl --aggregate-output fix:*",
    "fix:eslint": "eslint --fix .",
    "fix:format": "prettier --write .",
    "lint": "run-p -sl --aggregate-output lint:*",
    "lint-staged": "lint-staged",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:knip": "knip",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:spelling": "cspell .",
    "lint:types": "tsc --noEmit",
    "prepack": "run-s -sl clean build",
    "prepare": "husky; run-s -sl build",
    "test": "npm run test:base -- \"test/**/*.test.ts\"",
    "test:base": "node --import tsx --test",
    "test:watch": "npm run test:base -- --watch"
  },
  "dependencies": {
    "cosmiconfig": "^9.0.0",
    "glob": "^11.0.3",
    "tinybench": "^2.6.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.37.0",
    "@stylistic/eslint-plugin": "5.4.0",
    "@types/node": "24.7.0",
    "@types/wallabyjs": "0.0.15",
    "@types/yargs": "^17.0.33",
    "bupkis": "^0.11.1",
    "cspell": "9.2.1",
    "eslint": "9.37.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "knip": "5.64.2",
    "lint-staged": "16.2.3",
    "markdownlint-cli2": "0.18.1",
    "markdownlint-cli2-formatter-pretty": "0.0.8",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "1.3.3",
    "prettier-plugin-pkg": "0.21.2",
    "prettier-plugin-sort-json": "4.1.1",
    "tinybench": "5.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "zshy": "^0.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "knip": {
    "ignoreDependencies": [
      "@types/wallabyjs",
      "markdownlint-cli2-formatter-pretty"
    ],
    "ignore": [
      ".wallaby.js",
      "**/*.cts",
      "**/*.d.ts",
      "site/media/**/*"
    ],
    "tags": [
      "-knipignore"
    ],
    "node": {
      "entry": [
        "test/**/*.test.ts",
        "src/index.ts",
        "src/cli/index.ts",
        "examples/**/*.ts",
        "examples/**/*.js"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,cts,js,cjs,yml,json5}": [
      "eslint --fix",
      "prettier --write",
      "cspell"
    ],
    "**/!(package-lock).json": [
      "eslint --fix",
      "prettier --write",
      "cspell"
    ],
    "**/!(.github/prompts)/*.md": [
      "prettier --write",
      "cspell"
    ]
  },
  "prettier": {
    "jsdocCommentLineStrategy": "keep",
    "jsdocPreferCodeFences": true,
    "plugins": [
      "prettier-plugin-jsdoc",
      "prettier-plugin-pkg",
      "prettier-plugin-sort-json"
    ],
    "singleQuote": true,
    "tsdoc": true
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts",
      "./cli": "./src/cli/index.ts"
    }
  }
}
