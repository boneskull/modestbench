{
  "bail": false,
  "concurrent": false,
  "exclude": ["node_modules/**", "dist/**", "coverage/**"],
  "iterations": 1000,
  "metadata": {
    "project": "ModestBench Examples",
    "version": "1.0.0",
    "description": "Demonstration benchmarks for ModestBench framework"
  },
  "outputDir": "./benchmark-results",
  "pattern": "examples/**/*.bench.{js,ts}",
  "quiet": false,
  "reporterConfig": {
    "human": {
      "colors": true,
      "progress": true
    },
    "json": {
      "prettyPrint": true,
      "indent": 2
    },
    "csv": {
      "includeHeaders": true,
      "includeMetadata": true
    }
  },
  "reporters": ["human", "json"],
  "tags": [],
  "thresholds": {
    "maxMean": 1000000,
    "maxStdDev": 100000,
    "minOpsPerSecond": 1000,
    "maxMarginOfError": 5.0
  },
  "time": 5000,
  "timeout": 30000,
  "verbose": false,
  "warmup": 50
}
