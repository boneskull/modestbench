{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "allowCompoundWords": true,
  "caseSensitive": false,
  "dictionaries": [
    "companies",
    "css",
    "en_US",
    "filetypes",
    "fonts",
    "html",
    "misc",
    "node",
    "npm",
    "softwareTerms",
    "typescript"
  ],
  "ignorePaths": [
    ".coverage",
    ".profiles",
    ".tmp",
    ".tshy-build",
    ".vscode",
    "*.snapshot",
    "*.svg",
    "assets",
    "CHANGELOG.md",
    "coverage",
    "dist",
    "docs",
    "node_modules",
    "*.csv",
    "worktrees",
    "assets/*.ans",
    "assets/*.txt"
  ],
  "ignoreRandomStrings": true,
  "ignoreWords": [
    "modestbenchrc",
    "nodir",
    "unbrand",
    "bahmutov",
    "boneskull",
    "commitlintrc",
    "tyvm",
    "zshy",
    "wallabyjs",
    "qwen",
    "TKTK",
    "onsave",
    "toshimaru",
    "wagoid",
    "limitby",
    "Csvg",
    "mmodest",
    "mbench",
    "mnode",
    "mplatform",
    "mcpu",
    "mmem"
  ],
  "words": ["bupkis"]
}
