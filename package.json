{
  "name": "modestbench",
  "version": "0.1.0",
  "type": "module",
  "description": "A full-ass benchmarking framework for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boneskull/modestbench.git"
  },
  "homepage": "https://github.com/boneskull/modestbench#readme",
  "bugs": {
    "url": "https://github.com/boneskull/modestbench/issues"
  },
  "author": "Christopher Hiller <boneskull@boneskull.com>",
  "license": "BlueOak-1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "modestbench": "dist/cli/index.js"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.cts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "keywords": [
    "benchmark",
    "benchmarking",
    "cli",
    "csv",
    "framework",
    "json",
    "measurement",
    "metrics",
    "optimization",
    "perf",
    "performance",
    "profiling",
    "speed",
    "testing",
    "tinybench"
  ],
  "scripts": {
    "astro:build": "astro build --config astro.config.js",
    "astro:dev": "astro dev --config astro.config.js",
    "build": "run-s -sl build:compile build:schema",
    "build:compile": "zshy",
    "build:schema": "tsx scripts/generate-schema.ts",
    "clean": "rm -rf dist",
    "commitlint": "commitlint",
    "dev": "zshy --watch",
    "docs:build": "run-s docs:copy astro:build",
    "docs:copy": "node scripts/copy-docs.js",
    "docs:dev": "run-s docs:copy astro:dev",
    "docs:preview": "astro preview --config astro.config.js",
    "fix": "run-s -sl fix:*",
    "fix:eslint": "eslint --fix .",
    "fix:format": "prettier --write .",
    "fix:pkg": "npm pkg fix",
    "lint": "run-p -sl --aggregate-output lint:*",
    "lint-staged": "lint-staged",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:knip": "knip",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:spelling": "cspell .",
    "lint:types": "tsc --noEmit",
    "prepack": "run-s -s clean build",
    "prepare": "husky; run-s -s build",
    "pretest:base": "run-s -s build:compile",
    "test": "npm run test:base -- \"test/**/*.test.ts\"",
    "test:base": "node --import tsx --test --test-reporter=spec",
    "test:contract": "npm run test:base -- \"test/contract/**/*.test.ts\"",
    "test:integration": "npm run test:base -- \"test/integration/**/*.test.ts\"",
    "test:unit": "npm run test:base -- \"test/unit/**/*.test.ts\"",
    "test:watch": "npm run test:base -- --watch"
  },
  "dependencies": {
    "cosmiconfig": "9.0.0",
    "cosmiconfig-typescript-loader": "6.2.0",
    "glob": "11.0.3",
    "tinybench": "5.0.1",
    "yargs": "18.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.36.1",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.38.0",
    "@stylistic/eslint-plugin": "5.5.0",
    "@types/node": "24.8.1",
    "@types/wallabyjs": "0.0.15",
    "@types/yargs": "17.0.33",
    "astro": "^5.14.8",
    "bupkis": "0.11.1",
    "cspell": "9.2.1",
    "eslint": "9.38.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "knip": "5.66.1",
    "lint-staged": "16.2.4",
    "markdownlint-cli2": "0.18.1",
    "markdownlint-cli2-formatter-pretty": "0.0.8",
    "npm-run-all2": "8.0.4",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "1.3.3",
    "prettier-plugin-pkg": "0.21.2",
    "prettier-plugin-sort-json": "4.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "zshy": "0.4.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "knip": {
    "ignoreDependencies": [
      "@types/wallabyjs",
      "markdownlint-cli2-formatter-pretty"
    ],
    "ignore": [
      ".wallaby.js",
      "**/*.cts",
      "**/*.d.ts",
      "site/media/**/*",
      "worktrees/**/*",
      "site/src/content/**/*"
    ],
    "tags": [
      "-knipignore"
    ],
    "node": {
      "entry": [
        "scripts/**/*.ts",
        "test/**/*.test.ts",
        "src/index.ts",
        "src/cli/index.ts",
        "examples/**/*.ts",
        "examples/**/*.js"
      ]
    }
  },
  "lint-staged": {
    "package.json": [
      "npm pkg fix"
    ],
    "*.{ts,cts,js,cjs,yml,json5}": [
      "eslint --fix",
      "prettier --write",
      "cspell"
    ],
    "**/!(package-lock).json": [
      "eslint --fix",
      "prettier --write",
      "cspell"
    ],
    "**/!(.github/prompts)/*.md": [
      "prettier --write",
      "cspell"
    ]
  },
  "prettier": {
    "jsdocCommentLineStrategy": "keep",
    "jsdocPreferCodeFences": true,
    "plugins": [
      "prettier-plugin-jsdoc",
      "prettier-plugin-pkg",
      "prettier-plugin-sort-json"
    ],
    "singleQuote": true,
    "tsdoc": true
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts",
      "./cli": "./src/cli/index.ts",
      "./package.json": "./package.json"
    }
  }
}
