{
  "name": "modestbench",
  "version": "0.1.0",
  "description": "A framework which wraps around tinybench to provide structure, consistency and convenience to developers creating and maintaining benchmarks",
  "main": "dist/cli/index.js",
  "bin": {
    "modestbench": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "benchmark",
    "tinybench",
    "performance",
    "cli",
    "testing"
  ],
  "author": "Christopher Hiller <boneskull@boneskull.com>",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "consola": "^3.2.3",
    "glob": "^11.0.3",
    "tinybench": "^2.6.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "bupkis": "^0.3.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
