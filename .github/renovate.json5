{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:js-app',
    ':enableVulnerabilityAlerts',
    ':semanticCommits',
    'group:linters',
    'group:definitelyTyped',
    'security:minimumReleaseAgeNpm',
    'helpers:pinGitHubActionDigests',
    ':configMigration',
    ':automergeDigest',
  ],
  packageRules: [
    {
      matchManagers: ['npm'],
      patch: {
        automerge: true,
      },
      minor: {
        automerge: true,
      },
      pin: {
        automerge: true,
      },
      separateMinorPatch: true,
      matchDepTypes: ['devDependencies'],
    },
  ],
  labels: ['dependencies'],
  ignorePaths: [
    '**/node_modules/**',
    '**/test/**',
    '**/demo/**',
    '**/example*/**',
    'vendor/**/package.json',
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
}
